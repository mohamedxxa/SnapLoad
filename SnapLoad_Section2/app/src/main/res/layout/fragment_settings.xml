<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            android:text="@string/nav_settings"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- قسم إعدادات التحميل -->
        <TextView style="@style/SettingsSectionHeader" android:text="@string/section_download_settings" />

        <LinearLayout android:id="@+id/rowDownloadFolder" style="@style/SettingsRow">
            <TextView style="@style/SettingsRowLabel" android:text="@string/setting_download_folder" />
            <TextView
                android:id="@+id/tvDownloadFolderValue"
                style="@style/SettingsRowValue"
                tools:text="/Download/SnapLoad"
                xmlns:tools="http://schemas.android.com/tools" />
        </LinearLayout>

        <LinearLayout android:id="@+id/rowDefaultQuality" style="@style/SettingsRow">
            <TextView style="@style/SettingsRowLabel" android:text="@string/setting_default_quality" />
            <TextView
                android:id="@+id/tvDefaultQualityValue"
                style="@style/SettingsRowValue"
                tools:text="1080p"
                xmlns:tools="http://schemas.android.com/tools" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowWifiOnly"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="14dp"
            android:paddingEnd="20dp"
            android:paddingBottom="14dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/setting_wifi_only"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchWifiOnly"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:thumbTint="@color/primary_orange" />

        </LinearLayout>

        <!-- قسم المظهر -->
        <TextView style="@style/SettingsSectionHeader" android:text="@string/section_appearance" />

        <LinearLayout android:id="@+id/rowTheme" style="@style/SettingsRow">
            <TextView style="@style/SettingsRowLabel" android:text="@string/setting_theme" />
            <TextView
                android:id="@+id/tvThemeValue"
                style="@style/SettingsRowValue"
                tools:text="داكن"
                xmlns:tools="http://schemas.android.com/tools" />
        </LinearLayout>

        <LinearLayout android:id="@+id/rowLanguage" style="@style/SettingsRow">
            <TextView style="@style/SettingsRowLabel" android:text="@string/setting_language" />
            <TextView
                android:id="@+id/tvLanguageValue"
                style="@style/SettingsRowValue"
                tools:text="العربية"
                xmlns:tools="http://schemas.android.com/tools" />
        </LinearLayout>

        <!-- قسم السيرفر -->
        <TextView style="@style/SettingsSectionHeader" android:text="@string/section_server" />

        <LinearLayout android:id="@+id/rowServerUrl" style="@style/SettingsRow">
            <TextView style="@style/SettingsRowLabel" android:text="@string/setting_server_url" />
            <TextView
                android:id="@+id/tvServerUrlValue"
                style="@style/SettingsRowValue"
                tools:text="api.snapload.app"
                xmlns:tools="http://schemas.android.com/tools" />
        </LinearLayout>

        <LinearLayout android:id="@+id/rowServerTest" style="@style/SettingsRow">
            <TextView style="@style/SettingsRowLabel" android:text="@string/setting_test_connection" />
            <TextView
                android:id="@+id/tvServerTestValue"
                style="@style/SettingsRowValue"
                android:textColor="@color/success_green"
                tools:text="متصل"
                xmlns:tools="http://schemas.android.com/tools" />
        </LinearLayout>

        <!-- قسم المعلومات -->
        <TextView style="@style/SettingsSectionHeader" android:text="@string/section_about" />

        <LinearLayout android:id="@+id/rowAppVersion" style="@style/SettingsRow">
            <TextView style="@style/SettingsRowLabel" android:text="@string/setting_app_version" />
            <TextView
                android:id="@+id/tvAppVersionValue"
                style="@style/SettingsRowValue"
                tools:text="1.0.0"
                xmlns:tools="http://schemas.android.com/tools" />
        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
