<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:paddingStart="12dp"
    android:paddingTop="14dp"
    android:paddingEnd="12dp"
    android:paddingBottom="14dp">

    <TextView
        android:id="@+id/tvQualityLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="1080p Full HD"
        xmlns:tools="http://schemas.android.com/tools" />

    <TextView
        android:id="@+id/tvBestBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_best_badge"
        android:paddingStart="8dp"
        android:paddingTop="2dp"
        android:paddingEnd="8dp"
        android:paddingBottom="2dp"
        android:text="@string/label_best"
        android:textColor="@color/bg_dark"
        android:textSize="10sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/tvQualityLabel"
        app:layout_constraintStart_toEndOf="@id/tvQualityLabel"
        app:layout_constraintTop_toTopOf="@id/tvQualityLabel"
        tools:visibility="visible"
        xmlns:tools="http://schemas.android.com/tools" />

    <TextView
        android:id="@+id/tvQualityMeta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="@id/tvQualityLabel"
        app:layout_constraintTop_toBottomOf="@id/tvQualityLabel"
        tools:text="MP4 • 45.2 MB"
        xmlns:tools="http://schemas.android.com/tools" />

    <ImageView
        android:id="@+id/ivDownloadIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:contentDescription="@string/action_download_video"
        android:src="@drawable/ic_download_circle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/primary_orange" />

</androidx.constraintlayout.widget.ConstraintLayout>
